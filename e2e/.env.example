# Deterministic CI/local E2E environment. All values are fictional test values.
NEWSROOM_MODE=demo
NEWSROOM_PROFILE=cpu
NEWSROOM_VERSION=0.1.0
NEWSROOM_ADMIN_EMAIL=admin@example.local
NEWSROOM_DEMO_PASSWORD=e2e-demo-password
NEWSROOM_DEMO_EDITOR_EMAIL=editor@example.local
NEWSROOM_DEMO_VIEWER_EMAIL=viewer@example.local
PANEL_PORT=8080
API_GATEWAY_PORT=8099
PANEL_PUBLIC_ORIGIN=
API_GATEWAY_HOST=0.0.0.0
# Fixed example network for the CI/demo stack; the range is deliberately
# uncommon. Real installations get a free /24 from the installer instead, and
# a manual run can override these three values if the range is already used.
NEWSROOM_PANEL_SUBNET=10.247.193.0/24
NEWSROOM_PANEL_IP=10.247.193.10
TRUSTED_PROXY_CIDRS=10.247.193.10/32
API_GATEWAY_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
API_GATEWAY_TRUSTED_MUTATION_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
BLOB_ROOT=/app/data/blobs
MAX_UPLOAD_BYTES=524288000
API_GATEWAY_EVENTS_FILE=/app/runtime-logs/gateway-events.jsonl
POSTGRES_USER=newsroom
POSTGRES_PASSWORD=t8-postgres-password
POSTGRES_DB=newsroom
POSTGRES_PORT=5432
DATABASE_URL=postgres://newsroom:t8-postgres-password@postgres:5432/newsroom
LLM=demo
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_PORT=11434
NEWS_SOURCE=rss
# One invented player and the offline fixture feed served by the `e2e`
# Compose profile. The local-mode Playwright spec recreates the API with
# these values, so the run never depends on Google News or the operator's .env.
NEWS_DISCOVERY_FEED_URL=http://e2e-fixtures:8000/discovery.xml
NEWS_DISCOVERY_PLAYERS=[{"seleccion":"Aurenia","jugador":"Nicolás Arbelo"}]
ARTICLE_EXTRACTOR=demo
PYTHON_BIN=python3
IMAGE_SEARCH=searxng
SEARXNG_URL=http://searxng:8080
SEARXNG_PORT=8888
SEARXNG_SECRET=t8-searxng-secret
IMAGE_SEARCH_WIKIMEDIA=true
DOCUMENT_EXPORT=local
DOCUMENT_ROOT=/app/data/documents
CHANNEL_FEED=rss
MEDIA_DOWNLOAD=worker
NOTIFY=console
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=newsroom@example.local
STORAGE=fs
S3_ENDPOINT=http://minio:9000
S3_BUCKET=newsroom
S3_REGION=us-east-1
S3_ACCESS_KEY=e2e-minio
S3_SECRET_KEY=e2e-minio-password
MINIO_ROOT_USER=e2e-minio
MINIO_ROOT_PASSWORD=e2e-minio-password
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
JOBS_API_KEY=e2e-jobs-key # gitleaks:allow — deterministic E2E fixture
N8N_WEBHOOK_TOKEN=e2e-n8n-webhook-token
NEWSROOM_NOTIFY_EMAIL=editor@example.local
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
WORKFLOW=disabled
N8N_WEBHOOK_BASE_URL=http://n8n:5678
N8N_PORT=5678
N8N_ENCRYPTION_KEY=t8-n8n-encryption-key
TTS_WORKER_ENGINE=piper
TTS_WORKER_ALLOW_CPU_FALLBACK=1
PIPER_MODEL=es_ES-davefx-medium
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TTS_WORKER_INTERNAL_TOKEN=e2e-tts-worker-internal-token
OLLAMA_KEEP_ALIVE=30s
NEWSROOM_GPU_LOCK_PATH=/tmp/newsroom-gpu.lock
NEWSROOM_ENV_FILE=.env

# Service credentials used between the gateway and the local workers. Fictional
# test values only; the installer generates unique ones for real installs.
API_GATEWAY_SHARED_API_KEY=e2e-shared-key
API_GATEWAY_N8N_API_KEY=e2e-n8n-key
API_GATEWAY_TTS_API_KEY=e2e-tts-key
API_GATEWAY_TTS_BASIC_USER=local-tts
API_GATEWAY_TTS_BASIC_PASS=e2e-tts-pass
API_GATEWAY_SUBTITLES_API_KEY=e2e-subtitles-key
API_GATEWAY_SUBTITLES_BASIC_USER=local-subtitles
API_GATEWAY_SUBTITLES_BASIC_PASS=e2e-subtitles-pass
API_GATEWAY_RADAR_API_KEY=e2e-radar-key
API_GATEWAY_MONITOR_API_KEY=e2e-monitor-key
API_GATEWAY_APPROVAL_SECRET=e2e-approval-secret
API_GATEWAY_RENDERER_API_KEY=e2e-renderer-key
