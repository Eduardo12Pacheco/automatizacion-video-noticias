# Dependencies and tool caches
**/node_modules/
**/.pnpm-store/
**/.venv/
**/__pycache__/
*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.cache/
**/.vite/
**/.turbo/
**/.next/
**/.expo/
**/.understand-anything/tmp/
**/.understand-anything/intermediate/
*.egg-info/

# Local environment and secrets. Sanitized templates are intentionally versioned.
.newsroom/
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
!**/.env.template
**/secrets/
**/*-cookies.txt
**/*.pem
**/*.key
**/*.p12
**/*.pfx
apps/api/users.json
infra/n8n/files/credentials-final.json
infra/n8n/files/credentials-clean.json
infra/n8n/import/credentials.json

# Local service state, databases, generated media, and model downloads
/data/
local/backups/
local/models/
local/default-music/
# Runtime n8n exports remain ignored. The canonical sanitized reference is
# versioned separately under examples/legacy-n8n/.
infra/n8n/files/*
infra/n8n/import/*
recovery-artifacts/
# Root-anchored on purpose: a bare `runtime/` matches at any depth and silently
# excluded real source under apps/panel/js/modules/features/*/runtime/.
# Per-service nested .gitignore files still cover their own runtime state.
/runtime/
/runtime-logs/
/logs/
/temp/
infra/windows/logs/
profesor/data/runtime/
subtitles-local-minimal/runtime-remote/
services/approval-editor/projects/
services/renderer/projects/
services/renderer/public/generated/
services/tts-worker/output/
services/tts-worker/segments/
services/tts-worker/runtime/
services/tts-worker/models/
services/subtitles/output/
services/asr-worker/runtime/
services/asr-worker/runtime-logs/
services/channel-monitor/runtime/
services/channel-monitor/runtime-logs/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db
*.log

# Build and coverage outputs
**/dist/
**/build/
**/coverage/

# Local agent and editor state
.atl/
.pi/
**/.pi-agent/
**/.pi-sessions/
.playwright-mcp/

# Windows reserved device-name artifact
NUL

# Playwright/browser test artifacts
/test-results/
/playwright-report/
/blob-report/

# Runtime copies of examples/brand (generated by tools/assets/sync-runtime-assets.mjs)
apps/panel/assets/logo-clean.mp4
apps/panel/assets/logo-final.png
apps/panel/assets/logo-green.mp4
apps/panel/assets/logo-primary.webm
apps/panel/assets/logo-secondary.webm
apps/panel/assets/overlay-layer-01.webm
apps/panel/assets/overlay-layer-02.webm
apps/panel/assets/particle-*.webm
apps/panel/assets/boundary-transitions/*.mp4
apps/panel/assets/sfx/*.wav
apps/panel/assets/fonts/display/Demo-Display.woff2
