# Copy to .env. Do not commit .env.
N8N_HOST=n8n.example.local
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.example.local/
N8N_EDITOR_BASE_URL=https://n8n.example.local
N8N_PROXY_HOPS=1
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_GIT_NODE_DISABLE_BARE_REPOS=true
N8N_RUNNERS_ENABLED=true
DB_SQLITE_POOL_SIZE=5
NODE_ENV=production
GENERIC_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin

# Required for restored credentials. Fill from the existing backup config.
N8N_ENCRYPTION_KEY=REPLACE_WITH_BACKUP_ENCRYPTION_KEY
