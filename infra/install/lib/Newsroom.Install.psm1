# Install steps for install.ps1 and bin/newsroom.ps1 (Windows / PowerShell).
#
# Mirror of infra/install/lib/steps.sh. Depends on Newsroom.Core.psm1.

Import-Module (Join-Path $PSScriptRoot 'Newsroom.Core.psm1')

# Share the mutable configuration object with Newsroom.Core instead of relying
# on module-local copies of its script scope.
$script:NrConfig = Get-NrConfig

function Test-NrInteractive {
    if ($script:NrConfig.Yes) { return $false }
    if ($env:CI) { return $false }
    return [Environment]::UserInteractive
}

function Install-NrCli {
    param([string]$BinDir = '')
    if ($BinDir -eq '') {
        $BinDir = $script:NrConfig.BinDir
    }
    if ($BinDir -eq '') {
        if ($env:LOCALAPPDATA) {
            $BinDir = Join-Path $env:LOCALAPPDATA 'Newsroom/bin'
        } else {
            $BinDir = Join-Path $HOME '.local/bin'
        }
    }
    if ($script:NrConfig.DryRun) {
        Write-NrInfo "would install the newsroom CLI into $BinDir"
        return
    }
    if (-not (Test-Path -LiteralPath $BinDir -PathType Container)) {
        New-Item -ItemType Directory -Path $BinDir -Force | Out-Null
    }
    $repo = $script:NrConfig.RepoRoot
    $psLauncher = Join-Path $BinDir 'newsroom.ps1'
    $psContent = @"
# Generated by install.ps1. Runs the control CLI from the checkout that
# installed it; re-run install.ps1 if the repository moves.
param([Parameter(ValueFromRemainingArguments=`$true)][string[]]`$Remaining)
& "$repo/bin/newsroom.ps1" @Remaining
exit `$LASTEXITCODE
"@
    Write-NrLinesFile -Path $psLauncher -Lines @($psContent)

    $interpreter = 'powershell'
    if (Test-NrCommand 'pwsh') { $interpreter = 'pwsh' }
    $cmdLauncher = Join-Path $BinDir 'newsroom.cmd'
    $cmdContent = @"
@echo off
setlocal
$interpreter -NoProfile -ExecutionPolicy Bypass -File "$psLauncher" %*
exit /b %ERRORLEVEL%
"@
    [System.IO.File]::WriteAllText($cmdLauncher, $cmdContent, [System.Text.Encoding]::ASCII)
    Write-NrOk "installed CLI: $cmdLauncher"
    $pathEntries = ($env:PATH -split ';')
    if (-not ($pathEntries | Where-Object { $_ -eq $BinDir })) {
        Write-NrWarn "$BinDir is not in PATH; add it to run 'newsroom' from any shell"
    }
}

function Install-NrModels {
    param([switch]$Force)
    if (-not $script:NrConfig.DownloadModels) {
        Write-NrInfo 'skipping model download (-NoModels)'
        return
    }
    $mode = Get-NrEnvValue -Key 'NEWSROOM_MODE'
    if (-not $mode) { $mode = 'demo' }
    if ($mode -eq 'demo') {
        Write-NrInfo 'demo mode needs no models; skipping the download (-Mode local selects real local AI)'
        return
    }
    if (-not $Force -and (Get-NrStateValue -Key 'MODELS_DOWNLOADED') -eq '1') {
        Write-NrOk 'local models already downloaded'
        return
    }

    $ollamaModel = Get-NrEnvValue -Key 'OLLAMA_MODEL'
    if (-not $ollamaModel) { $ollamaModel = 'qwen2.5:3b-instruct' }
    $piperModel = Get-NrEnvValue -Key 'PIPER_MODEL'
    if (-not $piperModel) { $piperModel = 'es_ES-davefx-medium' }
    $whisperModel = Get-NrEnvValue -Key 'WHISPER_MODEL'
    if (-not $whisperModel) { $whisperModel = 'small' }
    Write-NrInfo 'local model download sizes (approximate):'
    Write-NrInfo "  Ollama $ollamaModel`: ~2 GB"
    Write-NrInfo "  Whisper $whisperModel`: ~0.5 GB"
    Write-NrInfo "  Piper $piperModel`: ~60 MB"
    Write-NrInfo 'downloading local models; this can take a while'

    $code = Invoke-NrCompose -Arguments @('--profile', 'local', 'run', '--rm', 'model-init')
    if ($code -ne 0) { Stop-NrInstall 'model download failed' }
    $code = Invoke-NrCompose -Arguments @('--profile', 'local', 'up', '-d', 'ollama')
    if ($code -eq 0) {
        $code = Invoke-NrCompose -Arguments @('--profile', 'local', 'exec', '-T', 'ollama', '/bin/ollama', 'pull', $ollamaModel)
    }
    if ($code -ne 0) { Write-NrWarn "Ollama model pull failed; run 'newsroom models pull' after the stack is healthy" }
    Set-NrStateValue -Key 'MODELS_DOWNLOADED' -Value '1'
    Write-NrOk 'local models ready'
}

function Install-NrMigrations {
    if ((Get-NrStateValue -Key 'MIGRATIONS_APPLIED') -eq '1') {
        Write-NrOk 'database migrations already applied'
        return
    }
    Write-NrInfo 'applying database migrations'
    $code = Invoke-NrCompose -Arguments @('run', '--rm', 'migrate')
    if ($code -ne 0) { Stop-NrInstall 'database migrations failed' }
    Set-NrStateValue -Key 'MIGRATIONS_APPLIED' -Value '1'
}

function Install-NrAdmin {
    if ((Get-NrStateValue -Key 'ADMIN_CREATED') -eq '1') {
        $script:NrConfig.AdminState = 'existing'
        $script:NrConfig.PendingAdminEmail = Get-NrEnvValue -Key 'NEWSROOM_ADMIN_EMAIL'
        Write-NrOk 'administrator account already initialized'
        return
    }

    $email = $env:NEWSROOM_ADMIN_EMAIL
    if (-not $email) { $email = Get-NrEnvValue -Key 'NEWSROOM_ADMIN_EMAIL' }
    if (-not $email -and (Test-NrInteractive)) {
        $answer = Read-Host -Prompt 'Administrator email [admin@example.local]'
        if ($answer) { $email = $answer }
    }
    if (-not $email) { $email = 'admin@example.local' }

    $password = $env:NEWSROOM_ADMIN_PASSWORD
    $generated = $false
    if (-not $password) {
        if (Test-NrInteractive) {
            $first = Read-NrSecret -Prompt 'Administrator password (min 8 chars)'
            $second = Read-NrSecret -Prompt 'Repeat administrator password'
            if ($first -ne $second) { Stop-NrInstall 'passwords do not match' }
            $password = $first
        } else {
            $password = New-NrPassword
            $generated = $true
        }
    }
    if ($password.Length -lt 8) {
        Stop-NrInstall 'administrator password must be at least 8 characters'
    }

    $arguments = @(
        'run', '--rm', '-T', 'api', 'node', 'scripts/create-admin.js',
        '--email', $email, '--password-stdin'
    )
    Write-NrInfo "creating the first administrator: $email"
    if ($script:NrConfig.DryRun) {
        Invoke-NrCompose -Arguments $arguments | Out-Null
    } else {
        $code = Invoke-NrComposeWithStdin -InputText $password -Arguments $arguments
        if ($code -ne 0) { Stop-NrInstall 'first-admin creation failed' }
        Set-NrStateValue -Key 'ADMIN_CREATED' -Value '1'
        if ($generated) {
            $script:NrConfig.PendingAdminPassword = $password
        }
        $script:NrConfig.PendingAdminEmail = $email
        $script:NrConfig.AdminState = 'created'
    }
    if ($script:NrConfig.DryRun) {
        $script:NrConfig.PendingAdminEmail = $email
        $script:NrConfig.AdminState = 'would-create'
    }
    $password = $null
}

function Write-NrInstallSummary {
    $port = Get-NrEnvValue -Key 'PANEL_PORT'
    if ($script:NrConfig.Port) { $port = $script:NrConfig.Port }
    if (-not $port) { $port = '8080' }
    $mode = Get-NrEnvValue -Key 'NEWSROOM_MODE'
    if (-not $mode) { $mode = $script:NrConfig.Mode }
    $profile = $script:NrConfig.Profile
    if ($profile -eq 'auto' -or -not $profile) { $profile = 'cpu' }
    $status = 'running'
    if (-not $script:NrConfig.StartStack -or $script:NrConfig.DryRun) { $status = 'not started' }
    $admin = $script:NrConfig.PendingAdminEmail
    if (-not $admin) { $admin = 'admin@example.local' }

    Write-Host ''
    Write-Host '+----------------------------------------------------------------------+'
    Write-Host ('| {0,-68} |' -f 'Newsroom installation summary')
    Write-Host '+----------------------------------------------------------------------+'
    Write-Host ('| {0,-68} |' -f "Panel:    http://127.0.0.1:$port ($status)")
    Write-Host ('| {0,-68} |' -f "Mode:     $mode")
    Write-Host ('| {0,-68} |' -f "Profile:  $profile")
    Write-Host ('| {0,-68} |' -f "Admin:    $admin")
    if ($script:NrConfig.PendingAdminPassword) {
        Write-Host ('| {0,-68} |' -f 'Generated administrator password (shown once):')
        Write-Host ('| {0,-68} |' -f $script:NrConfig.PendingAdminPassword)
    } elseif ($script:NrConfig.AdminState -eq 'created') {
        Write-Host ('| {0,-68} |' -f 'Password: the one you entered during installation')
    } else {
        Write-Host ('| {0,-68} |' -f 'Password: unchanged from the previous installation')
    }
    Write-Host ('| {0,-68} |' -f 'Start:    newsroom up')
    Write-Host ('| {0,-68} |' -f 'Stop:     newsroom down')
    Write-Host ('| {0,-68} |' -f 'Logs:     newsroom logs [service]')
    Write-Host ('| {0,-68} |' -f 'Health:   newsroom doctor')
    Write-Host '+----------------------------------------------------------------------+'
    Write-Host ''
    $script:NrConfig.PendingAdminPassword = ''
}

function Start-NrStack {
    if (-not $script:NrConfig.StartStack) {
        Write-NrInfo 'skipping stack start (-NoStart)'
        return
    }
    Write-NrInfo "building and starting the stack (profile: $($script:NrConfig.Profile))"
    $code = Invoke-NrCompose -Arguments @('up', '-d', '--build')
    if ($code -ne 0) { Stop-NrInstall 'the stack failed to start' }
    Set-NrStateValue -Key 'STACK_STARTED' -Value '1'
    Set-NrStateValue -Key 'PROFILE' -Value $script:NrConfig.Profile
    Set-NrStateValue -Key 'INSTALLED_AT' -Value ((Get-Date).ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ssZ'))
    Write-NrOk 'stack is running'
}

function Open-NrPanel {
    $port = Get-NrEnvValue -Key 'PANEL_PORT'
    if (-not $port) { $port = '8080' }
    if ($script:NrConfig.OpenPanel -and -not $script:NrConfig.DryRun) {
        try {
            Start-Process "http://127.0.0.1:$port" | Out-Null
            return
        } catch {
            # Fall through to printing the URL (headless / no browser).
        }
    }
    Write-NrInfo "open the panel at http://127.0.0.1:$port"
}

function Confirm-NrPurge {
    if ($script:NrConfig.ForcePurge) {
        Write-NrWarn 'force-purge: deleting volumes, local models and .env without confirmation'
        return $true
    }
    if ($script:NrConfig.Yes) {
        Write-NrWarn 'purge requires the typed confirmation; pass -ForcePurge for non-interactive use'
        return $false
    }
    $answer = Read-Host -Prompt "Type 'delete' to permanently delete volumes, local models and .env"
    if ($answer -ne 'delete') {
        Write-NrInfo "confirmation did not match 'delete'; keeping volumes, local models and .env"
        return $false
    }
    return $true
}

function Remove-NrStack {
    param([switch]$Purge)
    Write-NrInfo 'removing the Newsroom stack'
    if (Test-Path -LiteralPath $script:NrConfig.ComposeFile -PathType Leaf) {
        $code = Invoke-NrCompose -Arguments @('down', '--remove-orphans')
        if ($code -ne 0) { Write-NrWarn 'docker compose down reported an error' }
    } else {
        Write-NrWarn 'compose file not found; no containers were removed'
    }

    $deleteData = $false
    if ($Purge) {
        if (Confirm-NrPurge) {
            $deleteData = $true
        }
    }

    if ($deleteData -and -not $script:NrConfig.DryRun) {
        Invoke-NrCompose -Arguments @('down', '--volumes', '--rmi', 'local', '--remove-orphans') | Out-Null
        if (Test-Path -LiteralPath $script:NrConfig.StateDir) {
            Remove-Item -LiteralPath $script:NrConfig.StateDir -Recurse -Force
        }
        if (Test-Path -LiteralPath $script:NrConfig.EnvFile) {
            Remove-Item -LiteralPath $script:NrConfig.EnvFile -Force
        }
        Write-NrOk 'volumes, local models, images and .env removed'
    }

    if ($script:NrConfig.BinDir -and -not $script:NrConfig.DryRun) {
        foreach ($name in @('newsroom.ps1', 'newsroom.cmd')) {
            $path = Join-Path $script:NrConfig.BinDir $name
            if (Test-Path -LiteralPath $path) { Remove-Item -LiteralPath $path -Force }
        }
        Write-NrOk "removed CLI from $($script:NrConfig.BinDir)"
    }
    Write-NrOk 'uninstall complete'
}

Export-ModuleMember -Function *
