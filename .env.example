# Newsroom local installation template.
#
# install.sh / install.ps1 copy this file to .env and replace every
# __GENERATE__ token with a fresh random secret (the .env file is created with
# 0600 permissions and is git-ignored). Never commit the generated file.
#
# Docker Compose reads this file. The T8 compose stack must implement the
# service names used by the installers (see infra/install/COMPOSE_CONTRACT.md).

# --- Run mode --------------------------------------------------------------
# demo  = deterministic stubs, no model download, labelled in the panel
# local = real local AI on CPU (GPU optional): Ollama, Piper, faster-whisper
NEWSROOM_MODE=demo
# Compose profiles activated by `docker compose up` without extra flags.
# install.sh sets this to `local` when the local AI stack is selected.
COMPOSE_PROFILES=

# --- Installation metadata -------------------------------------------------
NEWSROOM_PROFILE=cpu
NEWSROOM_VERSION=0.1.0
NEWSROOM_ADMIN_EMAIL=admin@example.local
# Fictional demo accounts created by the seed service. Generated per install;
# the administrator account is the one printed by the installer.
NEWSROOM_DEMO_PASSWORD=__GENERATE__
NEWSROOM_DEMO_EDITOR_EMAIL=editor@example.local
NEWSROOM_DEMO_VIEWER_EMAIL=viewer@example.local

# --- Panel and API ---------------------------------------------------------
PANEL_PORT=8080
API_GATEWAY_PORT=8099
# Host interface for the published API and panel ports. 127.0.0.1 keeps the
# product private to this machine; set it to 0.0.0.0 (or a LAN address) only
# when you intentionally share it on your network.
NEWSROOM_BIND=127.0.0.1
# Optional fixed public origin for the panel (e.g. http://newsroom.lan:8080).
# Empty derives it from the reverse-proxy headers.
PANEL_PUBLIC_ORIGIN=
# Inside the Compose network the API must listen on all interfaces so the panel
# nginx proxy can reach it. It is never published directly: only the panel port
# is bound to NEWSROOM_BIND above, so this does not open the API to the host.
API_GATEWAY_HOST=0.0.0.0
# X-Forwarded-For is trusted only from these proxy networks. The default is the
# private Compose network; the panel nginx proxy sets the real client address.
TRUSTED_PROXY_CIDRS=172.16.0.0/12
API_GATEWAY_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
API_GATEWAY_TRUSTED_MUTATION_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
BLOB_ROOT=/app/data/blobs
MAX_UPLOAD_BYTES=524288000
API_GATEWAY_EVENTS_FILE=/app/runtime-logs/gateway-events.jsonl

# --- Postgres --------------------------------------------------------------
POSTGRES_USER=newsroom
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=newsroom
POSTGRES_PORT=5432
DATABASE_URL=postgres://newsroom:__GENERATE_POSTGRES_PASSWORD__@postgres:5432/newsroom

# --- Local adapters (no API key required by default) -----------------------
LLM=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_PORT=11434
NEWS_SOURCE=rss
# Optional single RSS feed for air-gapped installs/tests; empty keeps the
# per-player Google News RSS requests.
NEWS_DISCOVERY_FEED_URL=
ARTICLE_EXTRACTOR=trafilatura
PYTHON_BIN=python3
IMAGE_SEARCH=searxng
SEARXNG_URL=http://searxng:8888
SEARXNG_PORT=8888
SEARXNG_SECRET=__GENERATE__
IMAGE_SEARCH_WIKIMEDIA=true
DOCUMENT_EXPORT=local
DOCUMENT_ROOT=/app/data/documents
CHANNEL_FEED=rss
MEDIA_DOWNLOAD=worker
NOTIFY=console
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_STARTTLS=false
SMTP_FROM=newsroom@example.local
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
WORKFLOW=disabled
N8N_WEBHOOK_BASE_URL=http://n8n:5678
N8N_PORT=5678
N8N_ENCRYPTION_KEY=__GENERATE__

# --- Worker runtime --------------------------------------------------------
# Core-facing worker adapters: worker (HTTP), demo (deterministic) or none.
TTS=worker
ASR=worker
TRANSLATION=worker
RENDERER=worker
TTS_BASE_URL=http://127.0.0.1:8088
ASR_BASE_URL=http://127.0.0.1:8765
SUBTITLES_BASE_URL=http://127.0.0.1:8092
RENDERER_BASE_URL=http://127.0.0.1:8088
# Worker API keys are optional on the private Compose network. The gateway
# already injects its own proxy credentials; these are for direct adapter use.
ASR_API_KEY=
RENDERER_API_KEY=
TTS_API_KEY=
SUBTITLES_API_KEY=
# AUTH=local uses the bundled repository auth service; http points at a
# split-deployment /api/auth contract; demo keeps showcase mode keyless.
AUTH=local
AUTH_BASE_URL=http://127.0.0.1:8099
TTS_WORKER_ENGINE=auto
TTS_WORKER_ALLOW_CPU_FALLBACK=1
PIPER_MODEL=es_ES-davefx-medium
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TTS_WORKER_INTERNAL_TOKEN=__GENERATE__
OLLAMA_KEEP_ALIVE=30s
NEWSROOM_GPU_LOCK_PATH=/tmp/newsroom-gpu.lock

# --- Optional legacy / protected-service credentials -----------------------
# The default local stack does not use these. They stay generated so that an
# operator can enable protected adapters later without editing the template.
API_GATEWAY_SHARED_API_KEY=__GENERATE__
API_GATEWAY_N8N_API_KEY=__GENERATE__
API_GATEWAY_TTS_API_KEY=__GENERATE__
API_GATEWAY_TTS_BASIC_USER=local-tts
API_GATEWAY_TTS_BASIC_PASS=__GENERATE__
API_GATEWAY_SUBTITLES_API_KEY=__GENERATE__
API_GATEWAY_SUBTITLES_BASIC_USER=local-subtitles
API_GATEWAY_SUBTITLES_BASIC_PASS=__GENERATE__
API_GATEWAY_RADAR_API_KEY=__GENERATE__
API_GATEWAY_MONITOR_API_KEY=__GENERATE__
API_GATEWAY_APPROVAL_SECRET=__GENERATE__
# The first administrator is created by install.sh / install.ps1 through
# apps/api/src/create-admin.js; there is no plaintext panel user in .env.
