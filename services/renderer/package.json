{
  "name": "@newsroom/renderer",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.441",
    "@remotion/tailwind-v4": "4.0.441",
    "ffmpeg-static": "^5.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.441",
    "tailwindcss": "4.0.0",
    "zod": "^4.3.6",
    "@newsroom/contracts": "workspace:*"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.441",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "check:render-boundary": "node --test tests/render-only-boundary.test.js tests/video-engine-render-adapter.test.js",
    "lint": "eslint src && tsc",
    "render:video": "node scripts/render-video.js",
    "test": "node --test",
    "upgrade": "remotion upgrade",
    "approval:service:local": "node scripts/approval-pipeline-local-service.js",
    "legacy:approval-service:local": "node scripts/approval-pipeline-local-service.js",
    "legacy:diagnose:stt": "py scripts/transcribe-audio.py --diagnose-backends",
    "legacy:install:python-deps": "py -m pip install -r requirements.txt",
    "render:server": "node scripts/render/render-server.js"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./scripts/render-video.js",
    "./approval-pipeline-local-service": "./scripts/services/approval-pipeline-local-service.js",
    "./render-adapter": "./scripts/lib/render/video-engine-render-adapter.js"
  }
}
