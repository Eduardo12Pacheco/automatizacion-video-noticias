# Subtitles service configuration.
SUBTITLES_REMOTE_HOST=127.0.0.1
SUBTITLES_REMOTE_PORT=8092
SUBTITLES_REMOTE_WORKSPACE_ROOT=./runtime
SUBTITLES_REMOTE_API_KEY=replace-with-a-local-random-token
SUBTITLES_REMOTE_BASIC_USER=local-subtitles
SUBTITLES_REMOTE_BASIC_PASS=replace-with-a-local-password
# Optional local model identifiers for ASR and translation.
SUBS_ASR_MODEL=small
SUBS_MT_EN_ES_MODEL=
