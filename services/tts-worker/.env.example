# Copy this file to .env.local for the legacy local wrappers, or export the
# values in your shell. Replace every placeholder before use.
TTS_WORKER_INTERNAL_TOKEN=replace-with-a-local-random-token
TTS_WORKER_FRONTEND_API_KEY=replace-with-a-local-random-token
TTS_WORKER_BASIC_USER=local-tts
TTS_WORKER_BASIC_PASS=replace-with-a-local-password
TTS_WORKER_QUEUE_MAX=20
TTS_WORKER_JOB_TIMEOUT_SEC=1200
TTS_WORKER_DEVICE=cpu
TTS_WORKER_PYTHON=python
TTS_WORKER_INTERNAL_URL=http://127.0.0.1:8091
TTS_WORKER_REQUEST_TIMEOUT_SEC=30
TTS_WORKER_POLL_TIMEOUT_SEC=30
TTS_WORKER_RATE_LIMIT_PER_MIN=10
TTS_WORKER_QUEUE_MAX_HINT=20
TTS_WORKER_ALLOWED_ORIGINS=http://localhost:8080
# auto = Qwen on GPU, Piper on CPU; qwen/piper force an engine.
TTS_WORKER_ENGINE=piper
PIPER_MODEL=
TTS_WORKER_ALLOW_CPU_FALLBACK=1
NEWSROOM_GPU_LOCK_PATH=/tmp/newsroom-gpu.lock
NEWSROOM_GPU_LOCK_TIMEOUT_SECONDS=3600
