# Copy this file to .env.local and replace values.

# Shared internal token (worker <-> orchestrator)
TTS_WORKER_INTERNAL_TOKEN=REEMPLAZAR_TOKEN_INTERNO_64_CHARS

# Public API key (frontend -> orchestrator)
TTS_ORCH_FRONTEND_API_KEY=REEMPLAZAR_TOKEN_FRONTEND_64_CHARS

# Basic Auth (frontend -> orchestrator)
TTS_ORCH_BASIC_USER=panelaudio
TTS_ORCH_BASIC_PASS=REEMPLAZAR_PASSWORD_FUERTE

# Worker runtime
TTS_WORKER_QUEUE_MAX=20
TTS_WORKER_JOB_TIMEOUT_SEC=1200
TTS_WORKER_DEVICE=cuda:0
TTS_WORKER_PYTHON=C:/path/to/services/tts-worker/.venv-qwen/Scripts/python.exe

# Orchestrator runtime
TTS_ORCH_WORKER_BASE_URL=http://127.0.0.1:8091
TTS_ORCH_REQUEST_TIMEOUT_SEC=30
TTS_ORCH_POLL_TIMEOUT_SEC=30
TTS_ORCH_RATE_LIMIT_PER_MIN=10
TTS_ORCH_QUEUE_MAX_HINT=20

# CORS (comma separated)
TTS_ORCH_ALLOWED_ORIGINS=http://localhost:8080,https://panel.example.local
