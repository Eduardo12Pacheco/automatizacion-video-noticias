TRANSCRIPT_SERVICE_YT_DLP_COOKIES_PATH=secrets/youtube-cookies.txt
TRANSCRIPT_SERVICE_YT_DLP_JS_RUNTIME=
TRANSCRIPT_FETCH_MODE=local
TRANSCRIPT_REMOTE_FETCHER_URL=
TRANSCRIPT_REMOTE_FETCHER_TOKEN=
