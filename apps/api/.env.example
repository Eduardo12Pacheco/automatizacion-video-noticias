# Local API gateway configuration. Copy to .env and replace placeholders.
# The data layer defaults to in-memory + ./data/blobs for demo mode; set
# DATABASE_URL to a local Postgres (the installer runs infra/db/migrations).
DATABASE_URL=postgres://newsroom:replace-with-a-local-password@127.0.0.1:5432/newsroom
BLOB_ROOT=./data/blobs
MAX_UPLOAD_BYTES=524288000
# The default GUI usage only needs loopback host/port; service credentials
# are optional and used when forwarding to protected local services.
API_GATEWAY_HOST=127.0.0.1
API_GATEWAY_PORT=8099
API_GATEWAY_ALLOWED_ORIGINS=http://127.0.0.1:8080
API_GATEWAY_TRUSTED_MUTATION_ORIGINS=http://127.0.0.1:8080

# Shared inbound key and per-service credentials (optional, use local values).
API_GATEWAY_SHARED_API_KEY=replace-with-a-local-random-token
API_GATEWAY_N8N_API_KEY=replace-with-a-local-random-token
API_GATEWAY_TTS_API_KEY=replace-with-a-local-random-token
API_GATEWAY_TTS_BASIC_USER=local-tts
API_GATEWAY_TTS_BASIC_PASS=replace-with-a-local-password
API_GATEWAY_SUBTITLES_API_KEY=replace-with-a-local-random-token
API_GATEWAY_SUBTITLES_BASIC_USER=local-subtitles
API_GATEWAY_SUBTITLES_BASIC_PASS=replace-with-a-local-password
API_GATEWAY_RADAR_API_KEY=replace-with-a-local-random-token
API_GATEWAY_MONITOR_API_KEY=replace-with-a-local-random-token
API_GATEWAY_APPROVAL_SECRET=replace-with-a-local-random-token

# Panel identity (development only; local users are managed in the database).
API_GATEWAY_PANEL_USER=demo
API_GATEWAY_PANEL_PASS=replace-with-a-local-password
API_GATEWAY_PANEL_EMAIL=demo@example.local
API_GATEWAY_PANEL_DISPLAY_NAME=Demo User
API_GATEWAY_PANEL_USERS_FILE=
API_GATEWAY_PANEL_USERS=

# Event log retention.
API_GATEWAY_EVENTS_FILE=runtime-logs/gateway-events.jsonl
API_GATEWAY_EVENTS_MAX_EVENTS=5000
API_GATEWAY_EVENTS_MAX_AGE_DAYS=14
API_GATEWAY_EVENTS_MAX_BYTES=5242880

# Local-first adapters (T5). Every port has a local default and no API key is
# required. Set an adapter to "none" to keep the read/save surfaces without
# that capability; the API then returns a typed adapter_unavailable error.
LLM=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Optional OpenAI-compatible endpoint: LLM=openai + OPENAI_BASE_URL/OPENAI_MODEL/OPENAI_API_KEY.
NEWS_SOURCE=rss
RSS_TIMEOUT_MS=30000
ARTICLE_EXTRACTOR=trafilatura
PYTHON_BIN=python3
ARTICLE_EXTRACT_TIMEOUT_MS=60000
IMAGE_SEARCH=searxng
SEARXNG_URL=http://127.0.0.1:8888
IMAGE_SEARCH_WIKIMEDIA=true
IMAGE_SEARCH_TIMEOUT_MS=30000
DOCUMENT_EXPORT=local
DOCUMENT_ROOT=./data/documents
DOCUMENT_EXPORT_TIMEOUT_MS=60000
CHANNEL_FEED=rss
MEDIA_DOWNLOAD=yt-dlp
YT_DLP_BINARY=yt-dlp
YT_DLP_MAX_FILESIZE=2G
YT_DLP_MAX_DURATION_SECONDS=7200
# NOTIFY=console is the local default; use NOTIFY=smtp for Mailpit/Gmail.
NOTIFY=console
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=newsroom@example.local
# Optional n8n orchestration: WORKFLOW=n8n and a webhook base URL.
WORKFLOW=disabled
N8N_WEBHOOK_BASE_URL=http://127.0.0.1:5678
