{
  "name": "newsroom-video-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first newsroom video automation monorepo.",
  "packageManager": "pnpm@11.12.0+sha512.820a6fbd0d9f04c226638002aead1e45340a9139dd5dc077c1d83ef44aa2481c8eb6637b4c9aa696a3c7e35ba818e49cf27213e5f2b91138d09b7a3e26e898ba",
  "scripts": {
    "test:api": "node --test apps/api/test/*.test.js",
    "test:renderer": "node --test services/renderer/tests/*.test.js",
    "test:data": "node --test packages/data/test/*.test.js",
    "test:core": "node --test packages/core/test/*.test.js",
    "test:adapters": "node --test packages/adapters/test/*.test.js",
    "test:demo-worker": "node --test services/demo-worker/test/*.test.js",
    "test:e2e": "playwright test",
    "test:contracts": "node --test packages/contracts/test/*.test.js",
    "test:worker-ports": "node --test packages/adapters/test/worker-ports.test.js",
    "test:all": "node tools/run-all-tests.mjs",
    "test:checks": "node tools/run-panel-checks.mjs",
    "test:panel": "uv run --with pytest pytest apps/panel/tests -q",
    "test:visual": "node tools/run-visual-qa.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0"
  }
}
